# Supabase Public Configuration (Browser + Server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PS01 bounded server data-plane — ACTIVE Customer LINE path (H3D).
# Short-lived Auth-issued JWT with role=ps01_line_runtime, reaching PS01 only
# through the Supabase Data API. Server-only; never commit a real token; never
# use postgres/service_role here.
PS01_LINE_RUNTIME_JWT=

# Rollback/reference only (H3D). Direct pooler login via ps01_runtime_login.
# Not used by the active Customer LINE path; retired in H3E.
PS01_RUNTIME_DB_HOST=
PS01_RUNTIME_DB_PORT=5432
PS01_RUNTIME_DB_NAME=postgres
PS01_RUNTIME_DB_USER=
PS01_RUNTIME_DB_PASSWORD=

# Supabase Private Admin Configuration (OPTIONAL for Closed Beta core)
# Project-wide privilege: do not configure for PS01 core runtime. Required only by
# deferred/admin integration paths until a product-scoped privileged boundary is proven.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side LINE adapter
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=

# Server-side Google Sheets adapter (tenant target comes from shops.google_sheet_id)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SYNC_DISPATCH_SECRET=

# LINE Login / LIFF Claim (Phase 5)
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LINE_LIFF_ID=

# Phase 6 production LINE dispatcher (server-only, per-shop)
# JSON object keyed by shop UUID: {"<shop-uuid>":"<channel-access-token>"}
LINE_CHANNEL_ACCESS_TOKENS_JSON=
# Secret required by the internal dispatcher HTTP endpoint
LINE_DISPATCH_SECRET=
# Phase 8 public camera session security (server-only)
# Generate independent high-entropy secrets; never expose with NEXT_PUBLIC_ prefixes.
CAMERA_SESSION_SIGNING_SECRET=
CAMERA_IP_HASH_PEPPER=
# Trusted edge-controlled header containing the requester IP (for example: cf-connecting-ip)
CAMERA_REQUESTER_IP_HEADER=
# Comma-separated HTTPS camera bridge hostnames allowed for server-side streaming proxy
CAMERA_ALLOWED_FEED_HOSTS=

# Public app origin used to build Supabase Auth invite/reset redirect links (server-only).
# Must be present in supabase/config.toml [auth] additional_redirect_urls. Defaults to
# http://127.0.0.1:3000 if unset.
APP_BASE_URL=
