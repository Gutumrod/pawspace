# Supabase Public Configuration (Browser + Server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Private Admin Configuration (Server-Only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Server-side LINE adapter
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=

# Server-side Google Sheets adapter
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# LINE Login / LIFF Claim (Phase 5)
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LINE_LIFF_ID=

# Phase 6 production LINE dispatcher (server-only, per-shop)
# JSON object keyed by shop UUID: {"<shop-uuid>":"<channel-access-token>"}
LINE_CHANNEL_ACCESS_TOKENS_JSON=
# Secret required by the internal dispatcher HTTP endpoint
LINE_DISPATCH_SECRET=
